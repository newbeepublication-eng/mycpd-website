---
import Base from '../../layouts/Base.astro';
import { getAllPosts } from '../../lib/posts.js';
import { links } from '../../lib/site.js';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const fmt = (d) => d.toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' });
const related = posts.filter((p) => p.slug !== post.slug).sort((a, b) => (b.topic === post.topic) - (a.topic === post.topic)).slice(0, 3);
const url = new URL(`/blog/${post.slug}`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.summary,
  datePublished: post.date.toISOString(),
  dateModified: (post.updated || post.date).toISOString(),
  author: { '@type': 'Organization', name: post.author },
  publisher: { '@type': 'Organization', name: 'myCPD.ie', logo: { '@type': 'ImageObject', url: new URL('/icon.png', Astro.site).toString() } },
  mainEntityOfPage: url,
  ...(post.cover ? { image: post.cover } : {}),
};
---
<Base title={`${post.title} | myCPD.ie`} description={post.summary} type="article" image={post.cover || undefined} jsonLd={jsonLd} noindex={post.status === 'draft'}>
  <article>
    <header class="bg-[#F7F7F8] py-12 md:py-16">
      <div class="mx-auto max-w-[760px] px-4 sm:px-6">
        <a href="/blog" class="text-sm font-semibold text-[#52525B] underline underline-offset-4">← All articles</a>
        <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-[#71717A]">
          <span class="rounded-full bg-[#FFF3B0] px-2.5 py-1 text-xs font-semibold text-[#5A4600]">{post.topic}</span>
          {post.status === 'draft' && <span class="rounded-full bg-[#FEE2E2] px-2.5 py-1 text-xs font-semibold text-[#991B1B]">Draft, not public yet</span>}
          <span>{post.readingMinutes} min read</span>
        </div>
        <h1 class="mt-4 text-[32px] font-bold leading-[1.15] tracking-[-0.02em] md:text-[44px]">{post.title}</h1>
        <p class="lede mt-4">{post.summary}</p>
        <p class="mt-6 text-sm text-[#71717A]">{post.author} · {fmt(post.date)}{post.updated && ` · Updated ${fmt(post.updated)}`}</p>
      </div>
    </header>
    {post.cover && <img src={post.cover} alt="" class="mx-auto mt-8 block w-full max-w-[960px] rounded-2xl px-4 sm:px-6" />}
    <div class="mx-auto max-w-[760px] px-4 py-12 sm:px-6 md:py-16">
      <div class="prose" set:html={post.html} />
      <aside class="mt-14 rounded-[20px] bg-ink p-7 text-white sm:p-8">
        <h2 class="text-2xl font-bold">Keep your CPD record ready as you go</h2>
        <p class="mt-2 text-[#D4D4D8]">myCPD keeps your CPD, supervision, minutes and notes in one place, and exports a complete record when you need it.</p>
        <a href={links.startTrial} class="btn-yellow mt-6">Start your free 14-day trial</a>
        <p class="mt-3 text-xs text-[#A1A1AA]">No card needed.</p>
      </aside>
      <p class="mt-8 text-xs leading-relaxed text-[#71717A]">This article is general guidance, not regulatory or legal advice. Always check the current requirements of your own regulator. myCPD.ie is independent and not affiliated with or endorsed by any regulator.</p>
    </div>
  </article>
  {related.length > 0 && (
    <section class="border-t border-[#E4E4E7] bg-white py-12 md:py-16">
      <div class="wrap">
        <h2 class="mb-6 text-2xl font-bold">Keep reading</h2>
        <div class="grid gap-5 md:grid-cols-3">
          {related.map((p) => (
            <a href={`/blog/${p.slug}`} class="group rounded-[18px] border-[1.5px] border-[#E4E4E7] p-5 hover:border-[#A1A1AA]">
              <span class="text-xs font-semibold text-[#5A4600]">{p.topic}</span>
              <span class="mt-1 block text-lg font-semibold leading-snug group-hover:underline">{p.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
