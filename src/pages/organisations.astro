---
import Base from '../layouts/Base.astro';
import Tick from '../components/Tick.astro';
import { links, CONTACT_EMAIL } from '../lib/site.js';

const tiers = [
  { size: '3 to 50 users', off: '10% off', price: '€44.99', example: 'Team of 10: €449.90 a year' },
  { size: '51 to 150 users', off: '15% off', price: '€42.49', example: 'Team of 60: €2,549.40 a year' },
  { size: '151 to 200 users', off: '20% off', price: '€39.99', example: 'Team of 160: €6,398.40 a year' },
  { size: '200+ users', off: 'Custom', price: 'Quote', example: 'Contact us for a tailored plan' },
];

const features = [
  { t: 'Audit-ready CPD export', d: 'Supports CORU, NMBI and HCPC record-keeping formats.' },
  { t: 'Supervision log and reports', d: 'Sessions and reflections count towards CPD hours.' },
  { t: 'Supervision agreements', d: 'Send by email and sign online. No account needed to sign.' },
  { t: 'AI-assisted reflections', d: 'Turn quick notes into structured reflective entries.' },
  { t: 'Notes and meeting minutes', d: 'Team learning and meetings kept alongside the CPD record.' },
  { t: 'Named administrator', d: 'One contact for onboarding, seats and invoicing.' },
];

const steps = [
  { t: 'Get in touch', d: 'Email us your organisation name and roughly how many people are in your team.' },
  { t: 'Free team trial', d: 'Your team tries myCPD free for 14 days. No card needed.' },
  { t: 'Onboard and invoice', d: 'We help set up your team and send one annual invoice.' },
];

const faqs = [
  { q: 'What is the minimum team size?', a: 'Three users. Smaller teams can use individual plans.' },
  { q: 'Can we add people during the year?', a: 'Yes. Seats can be added at any time during the year.' },
  { q: 'How is it billed?', a: 'Annual billing, with one invoice for the whole organisation.' },
  { q: 'Can we try it first?', a: 'Yes. Your team can try myCPD free for 14 days. No card needed.' },
];

const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('myCPD team quote')}&body=${encodeURIComponent('Organisation name:\nApproximate team size:\nProfessions (e.g. OT, SLT, social care):\n')}`;
---
<Base title="myCPD for teams and organisations | myCPD.ie" description="Audit-ready CPD and supervision records for your whole team. Team pricing from €44.99 per user a year, with one invoice. Download the team pricing PDF.">
  <section class="bg-[#F7F7F8] py-14 md:py-20">
    <div class="wrap grid items-center gap-10 md:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="mb-4 inline-block rounded-full bg-ink px-3.5 py-1.5 text-[13px] font-semibold text-[#FFD000]">For teams and organisations</p>
        <h1 class="text-[34px] font-bold leading-tight tracking-[-0.02em] md:text-[48px]">Audit-ready CPD and supervision records for your whole team</h1>
        <p class="lede mt-4 max-w-[620px]">For clinics, HSE teams, disability services, social care providers and practices in Ireland and the UK.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
          <a href={mailto} class="btn-yellow">Request a team quote</a>
          <a href="/mycpd-team-pricing.pdf" download class="btn-outline">Download team pricing (PDF)</a>
        </div>
      </div>
      <div class="rounded-[20px] bg-[#0F766E] p-7 text-white sm:p-8">
        <p class="text-[15px] text-[#CCFBF1]">Team pricing</p>
        <div class="mt-1 text-[38px] font-bold tracking-[-0.02em]">From €44.99 <span class="block text-[15px] font-medium text-[#CCFBF1] sm:inline">per user a year</span></div>
        <p class="mt-2 text-[#CCFBF1]">Up to 20% off the individual price of €49.99. The bigger the team, the bigger the saving.</p>
        <ul class="mt-5 grid gap-2 text-[14.5px]">
          {['Every Professional feature for each person', 'One annual invoice', 'Free 14-day team trial', 'Seats can be added during the year'].map((f) => <li class="flex gap-2.5"><Tick />{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="wrap grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">The problem for managers</h2>
        <p class="mt-3 text-[16.5px] leading-relaxed text-[#52525B]">Any registrant can be selected for a CPD audit. When that happens, they need a complete 12-month record with reflections, not a folder of certificates and a scramble. Supervision notes and agreements are often scattered across paper, email and personal drives.</p>
      </div>
      <div>
        <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">What myCPD gives your team</h2>
        <p class="mt-3 text-[16.5px] leading-relaxed text-[#52525B]">One secure place for every staff member's CPD, supervision sessions, signed supervision agreements, notes and meeting minutes, ready to export whenever an audit, appraisal or registration renewal comes round.</p>
      </div>
    </div>
  </section>

  <section class="bg-[#F7F7F8] py-12 md:py-16">
    <div class="wrap">
      <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">Included for every team member</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-2xl border border-[#E4E4E7] bg-white p-6">
            <div class="flex items-center gap-2.5"><Tick /><h3 class="text-[17px] font-semibold">{f.t}</h3></div>
            <p class="mt-2 text-[15px] leading-relaxed text-[#52525B]">{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="team-pricing" class="scroll-mt-24 bg-white py-12 md:py-16">
    <div class="wrap">
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">Team pricing</h2>
        <p class="text-[15px] text-[#52525B]">Standard individual price: €49.99 per user a year</p>
      </div>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-[#E4E4E7]">
        <table class="w-full min-w-[560px] text-left text-[15px]">
          <thead class="bg-ink text-white">
            <tr><th class="px-5 py-3.5 font-semibold">Team size</th><th class="px-5 py-3.5 font-semibold">Discount</th><th class="px-5 py-3.5 font-semibold">Per user a year</th><th class="px-5 py-3.5 font-semibold">Example</th></tr>
          </thead>
          <tbody>
            {tiers.map((r, i) => (
              <tr class={i < tiers.length - 1 ? 'border-b border-[#E4E4E7]' : ''}>
                <td class="px-5 py-4 font-medium">{r.size}</td>
                <td class="px-5 py-4"><span class="rounded-full bg-[#FFF3B0] px-2.5 py-1 text-[13px] font-semibold text-[#6B5300]">{r.off}</span></td>
                <td class="px-5 py-4 text-[17px] font-bold">{r.price}</td>
                <td class="px-5 py-4 text-[#52525B]">{r.example}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-[14.5px] text-[#52525B]">Annual billing with one invoice for the whole organisation. Minimum 3 users. Seats can be added during the year.</p>
      <a href="/mycpd-team-pricing.pdf" download class="mt-5 inline-flex items-center gap-2 font-semibold underline underline-offset-4">Download the team pricing PDF to share with your manager</a>
    </div>
  </section>

  <section class="bg-[#F7F7F8] py-12 md:py-16">
    <div class="wrap">
      <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">How to get started</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="rounded-2xl border border-[#E4E4E7] bg-white p-6">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-[#FFD000] text-lg font-bold">{i + 1}</span>
            <h3 class="mt-4 text-[17px] font-semibold">{s.t}</h3>
            <p class="mt-1.5 text-[15px] leading-relaxed text-[#52525B]">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="wrap max-w-[860px]">
      <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">Questions from managers</h2>
      <div class="mt-6 divide-y divide-[#E4E4E7] border-y border-[#E4E4E7]">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none text-[17px] font-semibold">{f.q}</summary>
            <p class="mt-2 text-[15.5px] leading-relaxed text-[#52525B]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#0F766E] py-14 text-white md:py-16">
    <div class="wrap flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-[26px] font-bold tracking-[-0.01em] md:text-[30px]">Book a team quote</h2>
        <p class="mt-2 text-[#CCFBF1]">Email <a href={mailto} class="font-semibold text-white underline underline-offset-2">{CONTACT_EMAIL}</a> with your organisation name and team size.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={mailto} class="btn-yellow">Request a team quote</a>
        <a href={links.teamTrial} class="btn border-[1.5px] border-white text-white hover:bg-white/10">Start team trial</a>
      </div>
    </div>
    <p class="wrap mt-8 text-[13px] text-[#CCFBF1]">myCPD.ie supports CORU, NMBI and HCPC record-keeping. It is not affiliated with or endorsed by any regulator. myCPD.ie is a trading name of Newbee Hub Ltd. Prices shown per user per year.</p>
  </section>
</Base>
