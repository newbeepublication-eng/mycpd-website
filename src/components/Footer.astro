---
import Logo from './Logo.astro';
import { CONTACT_EMAIL } from '../lib/site.js';
const year = new Date().getFullYear();
---
<footer class="bg-ink pb-[max(3rem,env(safe-area-inset-bottom))] pt-12 text-sm text-[#A1A1AA]">
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <Logo />
        <p class="mt-4 max-w-[280px] leading-relaxed">Audit-ready CPD and supervision records for health and social care professionals.</p>
      </div>
      <div class="grid content-start gap-2">
        <p class="mb-1 font-semibold text-white">Features</p>
        <a href="/#cpd-recording" class="hover:text-white">CPD recording</a>
        <a href="/#supervision" class="hover:text-white">Supervision</a>
        <a href="/#minutes-notes" class="hover:text-white">Meeting minutes</a>
        <a href="/#notes" class="hover:text-white">Notes</a>
        <a href="/#pricing" class="hover:text-white">Pricing</a>
      </div>
      <div class="grid content-start gap-2">
        <p class="mb-1 font-semibold text-white">Resources</p>
        <a href="/blog" class="hover:text-white">Blog</a>
        <a href="/#faq" class="hover:text-white">FAQ</a>
        <a href="/mycpd-team-pricing.pdf" class="hover:text-white">Team pricing (PDF)</a>
      </div>
      <div class="grid content-start gap-2">
        <p class="mb-1 font-semibold text-white">Company</p>
        <a href="/privacy" class="hover:text-white">Privacy policy</a>
        <a href="/terms" class="hover:text-white">Terms of service</a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-white">Contact us</a>
      </div>
    </div>
    <div class="mt-10 border-t border-[#2F2F33] pt-6 text-xs leading-relaxed text-[#71717A]">
      <p>Your data is encrypted and GDPR compliant. myCPD.ie is independent and not affiliated with or endorsed by any regulator.</p>
      <p class="mt-1">© {year} Newbee Hub Ltd, trading as myCPD.ie. Made in Ireland.</p>
    </div>
  </div>
</footer>
