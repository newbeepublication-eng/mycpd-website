---
import Logo from './Logo.astro';
import { links } from '../lib/site.js';
const nav = [
  { label: 'CPD', href: '/#cpd-recording' },
  { label: 'Supervision', href: '/#supervision' },
  { label: 'Minutes', href: '/#minutes-notes' },
  { label: 'Notes', href: '/#notes' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/#faq' },
];
---
<header class="sticky top-0 z-50 border-b border-[#2F2F33] bg-ink pt-[env(safe-area-inset-top)]">
  <div class="wrap flex h-[68px] items-center justify-between">
    <a href="/" aria-label="myCPD home"><Logo /></a>
    <nav class="hidden items-center gap-2.5 xl:flex" aria-label="Main">
      {nav.map((l) => <a href={l.href} class="nav-pill">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={links.signIn} class="hidden rounded-[10px] border-[1.5px] border-[#52525B] px-3.5 py-[7px] text-sm font-medium text-white shadow-[0_3px_0_#09090B] transition-all hover:border-[#A1A1AA] active:translate-y-0.5 active:shadow-[0_1px_0_#09090B] xl:inline-block">Sign in</a>
      <a href={links.startTrial} class="btn-yellow hidden px-4 py-2.5 text-sm shadow-[0_3px_0_#B38B00,0_8px_14px_rgba(0,0,0,0.2)] sm:inline-flex">Start free trial</a>
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"
        class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#2F2F33] text-white shadow-[0_3px_0_#09090B,inset_0_1px_0_rgba(255,255,255,0.08)] active:translate-y-0.5 active:shadow-[0_1px_0_#09090B] xl:hidden">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" hidden class="border-t border-[#2F2F33] bg-ink px-4 pb-5 pt-2 xl:hidden">
    {nav.map((l) => <a href={l.href} class="block py-3 text-base text-[#E4E4E7]">{l.label}</a>)}
    <div class="mt-3 grid gap-3">
      <a href={links.startTrial} class="btn-yellow w-full">Start free trial</a>
      <a href={links.signIn} class="btn w-full border-[1.5px] border-[#52525B] text-white">Sign in</a>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open) => { menu.hidden = !open; btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  }
</script>
