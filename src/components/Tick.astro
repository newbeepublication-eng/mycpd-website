---
interface Props { teal?: boolean }
const { teal = false } = Astro.props;
---
<span class={`mt-0.5 flex h-[18px] w-[18px] flex-none items-center justify-center rounded-[5px] ${teal ? 'bg-brand-teal text-white' : 'bg-brand-yellow text-[#111111]'}`} aria-hidden="true">
  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
</span>
