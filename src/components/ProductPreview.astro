---
---
<div class="relative mx-auto w-full max-w-[540px] pb-10" aria-hidden="true">
  <div class="rounded-[20px] border border-[#2F2F33] bg-[#232326] p-5 text-white shadow-[0_30px_60px_rgba(24,24,27,0.25)] sm:p-6">
    <div class="mb-4 flex items-center justify-between">
      <span class="text-[15px] font-semibold">This CPD year</span>
      <span class="rounded-full bg-[#14B8A6]/15 px-2.5 py-1 text-xs font-medium text-[#5EEAD4]">On track</span>
    </div>
    <div class="grid grid-cols-[112px_1fr] items-center gap-4 sm:grid-cols-[150px_1fr] sm:gap-5">
      <svg viewBox="0 0 150 150" class="h-[112px] w-[112px] sm:h-[150px] sm:w-[150px]">
        <circle cx="75" cy="75" r="62" fill="none" stroke="#333338" stroke-width="12" />
        <circle cx="75" cy="75" r="62" fill="none" stroke="#FFD000" stroke-width="12" stroke-linecap="round" stroke-dasharray="324 390" transform="rotate(-90 75 75)" />
        <circle cx="75" cy="75" r="45" fill="none" stroke="#333338" stroke-width="9" />
        <circle cx="75" cy="75" r="45" fill="none" stroke="#14B8A6" stroke-width="9" stroke-linecap="round" stroke-dasharray="120 283" transform="rotate(-90 75 75)" />
        <text x="75" y="80" text-anchor="middle" fill="#fff" font-size="30" font-weight="700" font-family="Poppins, sans-serif">25</text>
        <text x="75" y="98" text-anchor="middle" fill="#A1A1AA" font-size="11" font-weight="500" font-family="Poppins, sans-serif">of 30 hours</text>
      </svg>
      <div class="grid gap-2.5 text-[13px] text-[#D4D4D8]">
        <div class="flex items-center justify-between rounded-xl border border-[#2F2F33] bg-[#1C1C1F] px-3 py-2.5">CPD hours <b class="text-[17px] text-[#FFD000]">25.0</b></div>
        <div class="flex items-center justify-between rounded-xl border border-[#2F2F33] bg-[#1C1C1F] px-3 py-2.5">Supervision <b class="text-[17px] text-[#5EEAD4]">6.5h</b></div>
        <div class="flex items-center justify-between rounded-xl border border-[#2F2F33] bg-[#1C1C1F] px-3 py-2.5">Next review <b class="text-[17px] text-white">14 Nov</b></div>
      </div>
    </div>
    <div class="mt-4 grid gap-2">
      <div class="flex items-center gap-3 rounded-xl border border-[#2F2F33] bg-[#1C1C1F] px-3 py-2.5 text-[13px]">
        <span class="flex h-[30px] w-[30px] flex-none items-center justify-center rounded-[9px] bg-[#FFD000] text-[#111]"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg></span>
        <span class="flex-1">Sensory integration workshop<small class="block text-[11.5px] text-[#A1A1AA]">Course, reflection added</small></span>
        <span class="font-semibold text-[#D4D4D8]">6.0h</span>
      </div>
      <div class="flex items-center gap-3 rounded-xl border border-[#2F2F33] bg-[#1C1C1F] px-3 py-2.5 text-[13px]">
        <span class="flex h-[30px] w-[30px] flex-none items-center justify-center rounded-[9px] bg-[#14B8A6] text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"/></svg></span>
        <span class="flex-1">Clinical supervision with M.K.<small class="block text-[11.5px] text-[#A1A1AA]">Supervision, 2 actions agreed</small></span>
        <span class="font-semibold text-[#D4D4D8]">1.5h</span>
      </div>
    </div>
  </div>
  <div class="absolute bottom-0 right-2 w-[230px] rotate-2 rounded-2xl border border-[#E4E4E7] bg-white p-4 text-[#111111] shadow-[0_20px_40px_rgba(24,24,27,0.2)] sm:-right-4 sm:w-[250px]">
    <div class="flex items-center gap-3">
      <span class="relative h-[42px] w-[34px] flex-none rounded-md bg-[#FFF3B0]"><span class="absolute right-0 top-0 h-0 w-0" style="border-style:solid;border-width:0 10px 10px 0;border-color:transparent #fff #F1D560 transparent"></span></span>
      <span><b class="block text-sm">CPD record 2026.pdf</b><small class="text-xs text-[#52525B]">12 entries, 31.5 hours</small></span>
    </div>
    <div class="mt-2.5 rounded-lg bg-[#CCFBF1] px-2.5 py-1.5 text-xs font-semibold text-[#0F766E]">Ready if you are selected for audit</div>
  </div>
</div>
